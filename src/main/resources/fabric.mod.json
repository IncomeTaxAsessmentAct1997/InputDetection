{
	"schemaVersion": 1,
	"id": "kpd",
	"version": "${version}",
	"name": "kpd",
	"description": "This is a mod that can detect input.",
	"authors": [
		"FallingUser",
		"IncomeTaxAsessmentAct1997"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/kpd/icon.png",
